# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
# File env: Vite carica anche .env e .env.production, e *.local non li copre.
# Un solo file d'esempio, se un giorno servirà, resta tracciabile.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
# AppleDouble resource forks (volumi esterni macOS / non-APFS)
._*
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# Golden fixture: listini reali con prezzi commerciali (fornitore + margini).
# Restano solo in locale — i test golden si auto-skippano se assenti.
# Pattern ampio: copre qualsiasi cartella fixtures sotto __tests__.
**/__tests__/fixtures/
src/parsers/__tests__/__snapshots__/parsers.golden.test.ts.snap
.playwright-mcp/
# Artefatti Playwright: gli aria-snapshot/screenshot dei fallimenti possono
# contenere dati sensibili (credenziali compilate, prezzi Rev_82) → mai committarli.
test-results/
playwright-report/

# Coverage vitest — output rigenerabile (`vitest run --coverage`).
coverage/

# graphify knowledge graph — artefatto locale (struttura codice + findings review)
graphify-out/

# Artefatti cartografia per-data (locali, rigenerabili). I report di review versionati
# stanno in docs/audit/ dal 07/10/2026.
REVIEW/20*/

# Report vitest della CI (`--outputFile`): artefatto, mai da committare.
vitest-report.json

# Lavoro locale di sessione (prompt, audit, prove): mai nel repo
/tmp/

# Settings personali di Claude Code (gli allow di questa macchina): mai nel repo.
# Oggi li ignora solo il gitignore globale di chi lavora qui; questa riga vale su ogni clone.
.claude/settings.local.json
